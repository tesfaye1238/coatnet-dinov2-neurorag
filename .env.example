# Copy to .env (never commit .env). No secret is required to run the tests or the local demo.
# Optional: path to a trained checkpoint for the Streamlit demo
NEUROFUSION_CHECKPOINT=
# Optional: directory of a built retrieval index
NEUROFUSION_RAG_INDEX=rag_index
# Optional: Hugging Face token ONLY if you use gated models; never paste it into chat or commit it
HF_TOKEN=
